# ──────────────────────────────────────────────────────────────────────────
#  Workday RAAS (Report-as-a-Service) — server-side configuration
#
#  The app reads the report URL and ISU credentials from here (server side):
#  the "Fetch User Activity" button sends an EMPTY request body and the API
#  route fills in these values. They are read ONLY in the Next.js API route,
#  are never sent to the browser, and are never logged.
# ──────────────────────────────────────────────────────────────────────────

# Full Workday RAAS report URL (https). Example:
#   https://wd2-impl-services1.workday.com/ccx/service/customreport2/<tenant>/<owner>/View_User_Activity_-_MG
# A ?format=json suffix is added automatically if absent.
RAAS_URL=

# ISU (Integration System User) Basic-auth credentials.
RAAS_USERNAME=
RAAS_PASSWORD=

# Optional: lock the RAAS endpoint to a fixed URL (defense-in-depth — prevents
# the route from being used as an open proxy). If set, the UI-supplied URL must
# start with this value. Leave blank to allow any https Workday URL.
RAAS_ALLOWED_URL_PREFIX=
